# Copia este archivo como .env y configura valores únicos para cada entorno.
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga
DB_USER=usuario_base_datos
DB_PASSWORD=contrasena_base_datos
DB_HOST=localhost
DB_NAME=librospe_db
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=correo@example.com
EMAIL_PASSWORD=contrasena_smtp
EMAIL_FROM=correo@example.com
DEBUG=false
SESSION_COOKIE_SECURE=true
AUTO_CREATE_SCHEMA=false
UPLOAD_FOLDER=static/img/productos

# Consulta DNI/RUC - APIsPERU (apisperu.com)
# Token personal obtenido en https://apisperu.com
API_PERU_TOKEN=
DNI_API_URL=https://dniruc.apisperu.com/api/v1/dni
RUC_API_URL=https://dniruc.apisperu.com/api/v1/ruc

# Mapa de delivery (Leaflet + OpenStreetMap, sin clave API)
# Punto de la libreria para el marcador del mapa. Formato decimal,no grados con signo.
# Libreria Salesiana Don Bosco (Colegio Salesiano Santa Rosa, Huancayo):
MAPA_TIENDA_LAT=-12.06586288155065
MAPA_TIENDA_LNG=-75.21539735474676
MAPA_TIENDA_NOMBRE="Librería Salesiana"
# Nominatim exige identificar el cliente en el User-Agent.
# IMPORTANTE: los valores con espacios o paréntesis van entre comillas; el
# script sincronizar.sh hace `source .env` con `set -e` y un valor sin comillas
# rompería el cron horario.
MAPA_USER_AGENT="LibreriaSalesiana/1.0 (proyecto academico)"

# Microservicios: 1 BD por servicio + token interno + URLs servicio-a-servicio
MS_VENTAS_DB=librospe_ms_ventas
MS_INVENTARIO_DB=librospe_ms_inventario
MS_USUARIOS_DB=librospe_ms_usuarios
MS_CLIENTES_DB=librospe_ms_clientes
SERVICE_TOKEN=librospe-interno-dev
MS_INVENTARIO_URL=http://127.0.0.1:8001
MS_VENTAS_URL=http://127.0.0.1:8002
MS_USUARIOS_URL=http://127.0.0.1:8003
MS_CLIENTES_URL=http://127.0.0.1:8004
