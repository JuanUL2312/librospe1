# Copia este archivo como .env y configura valores únicos para cada entorno.
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga
DB_USER=usuario_base_datos
DB_PASSWORD=contrasena_base_datos
DB_HOST=localhost
DB_NAME=librospe_db
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=correo@example.com
EMAIL_PASSWORD=contrasena_smtp
EMAIL_FROM=correo@example.com
DEBUG=false
SESSION_COOKIE_SECURE=true
AUTO_CREATE_SCHEMA=false
UPLOAD_FOLDER=static/img/productos

# Consulta DNI/RUC - APIsPERU (apisperu.com)
# Token personal obtenido en https://apisperu.com
API_PERU_TOKEN=
DNI_API_URL=https://dniruc.apisperu.com/api/v1/dni
RUC_API_URL=https://dniruc.apisperu.com/api/v1/ruc

# Facturación electrónica SUNAT (APIsPERU) - ver www/sunat_service.py
# simulado: sin llamadas externas (hash local, rotulo "SIMULADA")
# beta: ambiente de pruebas de SUNAT (no requiere certificado)
# produccion: requiere plan de facturación + certificado .pfx + usuario SOL
SUNAT_MODE=simulado
FACTURACION_API_URL=https://facturacion.apisperu.com/api/v1
FACTURACION_USER=
FACTURACION_PASS=

# Mapa de delivery (Leaflet + OpenStreetMap, sin clave API)
# Punto de la libreria para el marcador del mapa. Formato decimal,no grados con signo.
# Libreria Salesiana Don Bosco (Colegio Salesiano Santa Rosa, Huancayo):
MAPA_TIENDA_LAT=-12.06586288155065
MAPA_TIENDA_LNG=-75.21539735474676
MAPA_TIENDA_NOMBRE="Librería Salesiana"
# Nominatim exige identificar el cliente en el User-Agent.
# IMPORTANTE: los valores con espacios o paréntesis van entre comillas; el
# script sincronizar.sh hace `source .env` con `set -e` y un valor sin comillas
# rompería el cron horario.
MAPA_USER_AGENT="LibreriaSalesiana/1.0 (proyecto academico)"

# Microservicios: 1 BD por servicio + token interno + URLs servicio-a-servicio
MS_VENTAS_DB=librospe_ms_ventas
MS_INVENTARIO_DB=librospe_ms_inventario
MS_USUARIOS_DB=librospe_ms_usuarios
MS_CLIENTES_DB=librospe_ms_clientes
SERVICE_TOKEN=librospe-interno-dev
MS_INVENTARIO_URL=http://127.0.0.1:8001
MS_VENTAS_URL=http://127.0.0.1:8002
MS_USUARIOS_URL=http://127.0.0.1:8003
MS_CLIENTES_URL=http://127.0.0.1:8004

# =========================================================
# AGENTE DE MENSAJES (RabbitMQ)
# El gateway publica los eventos del dominio y cada microservicio
# consume los que le corresponden (en vez de copiar tablas por SQL).
# En local: docker compose up rabbitmq  ->  amqp://guest:guest@localhost:5672/
# En produccion: broker externo (CloudAMQP, RabbitMQ Cloud, etc.)
# Si AMQP_URL queda vacio, NO se pierde nada: los eventos se guardan en
# la tabla `eventos_pendientes` (outbox) y el cron `procesar_eventos.sh`
# los reintenta cuando el broker este disponible.
# =========================================================
AMQP_URL=
AMQP_EXCHANGE=librospe.eventos
AMQP_COLA_INVENTARIO=librospe.inventario
AMQP_COLA_VENTAS=librospe.ventas
AMQP_COLA_USUARIOS=librospe.usuarios
AMQP_COLA_CLIENTES=librospe.clientes
# Credenciales del broker de Docker (solo desarrollo)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# =========================================================
# SMS (comprobante de compra por mensaje de texto)
# Elige el proveedor y completa sus credenciales. Si SMS_PROVIDER
# queda vacio NO se envia SMS y el comprobante cae al correo.
#   twilio    -> cuenta https://console.twilio.com
#   textlocal -> cuenta https://www.textlocal.com
#   webhook   -> cualquier gateway propio (recibe JSON {telefono, mensaje})
# =========================================================
SMS_PROVIDER=
# SMS_TWILIO_SID=
# SMS_TWILIO_TOKEN=
# SMS_TWILIO_FROM=
# SMS_TEXTLOCAL_USER=
# SMS_TEXTLOCAL_PASS=
# SMS_TEXTLOCAL_FROM=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
